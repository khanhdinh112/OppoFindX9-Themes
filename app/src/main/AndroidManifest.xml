<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <application android:theme="@style/Theme.NatureRun" android:label="Nature Run">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.HOME"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
    </activity>
    <receiver android:name=".RunningWidgetReceiver" android:exported="true">
      <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/running_widget_info" />
    </receiver>
    <activity android:name=".OverlayActivity" android:theme="@style/Theme.NatureRun" android:exported="false" />
  </application>
</manifest>
